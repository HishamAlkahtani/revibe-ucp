# Required for chat. Kept on the server, never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# true = create/get/update_cart. false = create/get/update_checkout (default).
USE_CART=false
# Pretty-print AI tool arguments and MCP request/response payloads, redacted.
LOG_TOOL_PAYLOADS=true
# Optional Shopify checkout authentication. Not the OpenAI API key.
UCP_ACCESS_TOKEN=
# Required for Shopify token-tier calls: the buyer's actual public IP.
UCP_BUYER_IP=
# Go reads this file from the project root. Next runs on :3000, Go on :8080.
# Development uses Shopify's public example agent profile. Before production,
# host your own UCP agent profile at a public HTTPS URL and set it here.
UCP_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
